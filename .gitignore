*.duckdb
*.duckdb.wal
*.tmp

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/

# OS / editors
.DS_Store
.idea/
.vscode/
~$*.xlsx

# Big CSV copies of the facts (rebuilt by the pipeline; the Parquet versions are committed)
data/processed/fact_orders.csv
data/processed/fact_reconciliation.csv
